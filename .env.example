# Required for AI analysis (free key: https://aistudio.google.com/apikey).
# Without it the scanner still works using the offline pattern engine.
GEMINI_API_KEY=

# Optional: override models (defaults shown). "-latest" aliases auto-update when Google retires a model.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Optional: set when you add a custom domain (used for canonical URLs, sitemap, OG images)
# NEXT_PUBLIC_SITE_URL=https://cyber-kavach.vercel.app

# Optional: free verification codes from Google Search Console / Bing Webmaster Tools
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Recommended: public grievance/privacy contact shown in the Privacy Policy (DPDP Act)
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Recommended: public grievance/privacy contact shown in the Privacy Policy (DPDP Act)
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
